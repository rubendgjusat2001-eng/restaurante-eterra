# Supabase — proyecto (públicas, seguras de exponer en el navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Service Role Key (SECRETA, solo servidor). Se obtiene en:
# Supabase Dashboard > Project Settings > API > service_role key.
# NUNCA debe llevar el prefijo NEXT_PUBLIC_ ni exponerse al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Clave para firmar las cookies de sesión (JWT). Genera una cadena aleatoria larga,
# por ejemplo con: openssl rand -base64 48
SESSION_SECRET=
